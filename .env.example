# ==========================================
# Backend Environment Variables
# Copy this file to .env and fill in real values.
# On Vercel, set these in Project Settings → Environment Variables.
# NEVER commit .env to version control.
# ==========================================

# Node environment: development | production
NODE_ENV=development

# Port for the Express server (local dev only — Vercel ignores this)
PORT=5000

# MongoDB connection string (required)
# Format: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority&tls=true&authSource=admin
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/investment-platform?retryWrites=true&w=majority&tls=true

# JSON Web Token secret — MUST be a long, random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_here

# Token expiry duration (default: 7d)
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# CORS (Optional)
# These origins are already hardcoded as defaults:
#   http://localhost:5173, http://127.0.0.1:5173
#   http://localhost:5000, http://127.0.0.1:5000
#   https://investmentplanfrontend.vercel.app
# Only add extra origins here (e.g. Vercel preview deployments, custom domains).
# ALLOWED_ORIGINS=https://my-custom-domain.com,https://preview-abc.vercel.app
